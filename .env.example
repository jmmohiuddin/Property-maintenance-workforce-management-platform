# ── Database ─────────────────────────────────────────────────────────────────
# MUST connect as an application role with NOBYPASSRLS. Connecting as a
# superuser silently disables every row-level security policy and therefore
# every tenant-isolation guarantee, with no error. packages/db checks this on
# boot and refuses to start in production.
DATABASE_URL=postgres://meridian_app:meridian_dev_only@localhost:5432/meridian_dev
DATABASE_POOL_MAX=10

# Superuser connection, used ONLY by migrations and the seed script. Never
# expose this to the application.
DATABASE_ADMIN_URL=postgres://localhost:5432/meridian_dev

# Which tenant owns the public marketing site. Quote-form enquiries land in
# this tenant's lead queue. Must match a `tenants.slug`.
PUBLIC_TENANT_SLUG=meridian

# ── Web ──────────────────────────────────────────────────────────────────────
# Every absolute URL in JSON-LD, the sitemap and llms.txt derives from this.
# Setting it wrong silently poisons all structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
