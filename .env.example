# ── Database ─────────────────────────────────────────────────────────────────
# MUST connect as an application role with NOBYPASSRLS. Connecting as a
# superuser silently disables every row-level security policy and therefore
# every tenant-isolation guarantee, with no error. packages/db checks this on
# boot and refuses to start in production.
DATABASE_URL=postgres://meridian_app:meridian_dev_only@localhost:5432/meridian_dev
DATABASE_POOL_MAX=10

# Superuser connection, used ONLY by migrations and the seed script. Never
# expose this to the application.
DATABASE_ADMIN_URL=postgres://localhost:5432/meridian_dev

# Which tenant owns the public marketing site. Quote-form enquiries land in
# this tenant's lead queue. Must match a `tenants.slug`.
PUBLIC_TENANT_SLUG=meridian

# ── Web ──────────────────────────────────────────────────────────────────────
# Every absolute URL in JSON-LD, the sitemap and llms.txt derives from this.
# Setting it wrong silently poisons all structured data. It is read at BUILD
# time, so it must be correct before the build, not after.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Notifications ────────────────────────────────────────────────────────────
# BOTH must be set or no email is sent. With neither, the console transport is
# used: the ledger records "sent" and nothing reaches anybody. selectTransport()
# logs loudly when it falls back, and louder still if only one is set.
#
# The from address must be on a domain verified with the provider, or every
# send is rejected 403 — and that failure is deliberately NOT retried, because
# retrying it five times produces the same rejection five times.
RESEND_API_KEY=
# Must be on a domain verified with the provider. OPEN-10.
NOTIFY_FROM=

# ── Company identity (ADM-9) ─────────────────────────────────────────────────
# Identity used to live as constants in packages/core/src/tenant.ts, where it
# was a placeholder brand with an invented licence number that shipped to a live
# site. It now lives here, because identity is data: it changes when a licence
# renews, when a TRN is issued, when the office moves — and a data change should
# not require a deploy.
#
# THE RULE FOR THESE VALUES: leave a variable blank rather than filling it with
# something plausible. Blank means the claim is omitted from the page, the
# footer, the document and the JSON-LD. A placeholder means a false statement is
# published. `missingRequiredFields()` in packages/core/src/company.ts reports
# what is still unset and what each gap blocks.

# Verified from the licence. Override for staging so it does not display a real
# licence number.
COMPANY_LEGAL_NAME="Sumon Akon Technical Services"
COMPANY_TRADING_NAME=
COMPANY_BRAND_NAME="Sumon Akon Technical Services"
COMPANY_LICENCE_NUMBER=930137
COMPANY_LICENCE_ISSUER="Dubai Department of Economy and Tourism"
COMPANY_LICENCE_EXPIRY=2027-01-23

# REQUIRED before the site is fit to publish. Cabinet Resolution 107/2022 Art. 7
# obliges the Commercial Register number to be displayed on the website and on
# all documents and printed material (WEB-14).
COMPANY_CR_NUMBER=

# REQUIRED before a single tax invoice can be issued (INV-3). 15 digits. If the
# business is not yet VAT registered, that is OPEN-7 and it is urgent —
# registration is mandatory above AED 375,000 of taxable supplies.
COMPANY_TRN=

# REQUIRED. The emergency number is WEB-4: it must be reachable in one tap from
# every page, on a static path that works when the database does not.
COMPANY_PHONE=
COMPANY_EMERGENCY_PHONE=
COMPANY_WHATSAPP=
COMPANY_EMAIL=

COMPANY_ADDRESS_STREET=
COMPANY_ADDRESS_CITY=Dubai
COMPANY_ADDRESS_REGION=Dubai
COMPANY_ADDRESS_COUNTRY="United Arab Emirates"
# Geo coordinates for the LocalBusiness JSON-LD block (WEB-7). Both or neither.
COMPANY_LAT=
COMPANY_LNG=

# ── Scheduled work (ADM-5) ───────────────────────────────────────────────────
# Every /api/cron/* route refuses every request unless this is set and matched,
# in every environment including development. An unauthenticated cron endpoint
# drains queues, expires records and sends mail on demand.
#
#   openssl rand -hex 32
#
# On Vercel, set this and the platform sends it as `Authorization: Bearer …`.
# Any other scheduler can send it as `x-cron-secret` instead.
CRON_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────
# Set to 1 to emit Content-Security-Policy-Report-Only instead of enforcing.
# Run report-only for a week after any policy change, watch for violations, then
# unset it. A strict CSP shipped straight to enforce is one that gets reverted
# in a hurry and never re-applied.
CSP_REPORT_ONLY=

# Set to 1 for local production builds and CI, which have no real identity and
# are testing that the build works rather than shipping it. NEVER set this in a
# real deployment — it is the one thing standing between a placeholder value and
# a published tax invoice. See assertPublishableIdentity() in packages/core.
ALLOW_PLACEHOLDER_IDENTITY=
